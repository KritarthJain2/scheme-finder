# Copy to .env or export these in your shell. Never commit real keys.
# TAVILY_API_KEY is REQUIRED for any real result. Without it /api/find returns 503.
# TAVILY_API_KEY=
# NEBIUS_API_KEY is required for live Nemotron ranking and for the Token Factory submission claim.
# NEBIUS_API_KEY=
# NEBIUS_MODEL=nvidia/nemotron-3-nano-omni
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# PORT=8000
